# ---------------------------------------------------------------------------
# Production (Docker Compose on the VPS). Copy to .env, fill in, chmod 600.
# Generate each secret with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
DB_NAME=fursan
DB_ADMIN_USER=fursan_admin
DB_ADMIN_PASSWORD=
DB_APP_USER=fursan_app
DB_APP_PASSWORD=
SESSION_SECRET=
APP_PORT=3100

# ---------------------------------------------------------------------------
# Local development only (npm run dev / npm start against a local Postgres).
# ---------------------------------------------------------------------------
# SQL_HOST=127.0.0.1
# SQL_PORT=5432
# SQL_DB_NAME=fursan
# SQL_USER=fursan_app
# SQL_PASSWORD=
# SQL_ADMIN_USER=fursan_admin      # migrations only (drizzle-kit)
# SQL_ADMIN_PASSWORD=
# SESSION_SECRET=                  # optional in development
# COOKIE_SECURE=false              # when testing production mode over plain http
